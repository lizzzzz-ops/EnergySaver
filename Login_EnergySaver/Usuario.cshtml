@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>EnergySaver - Usuario</title>

    <style>
        body {
            margin: 0;
            font-family: 'Segoe UI', sans-serif;
            background: linear-gradient(135deg, #0f2027, #2ecc71);
            color: white;
        }

        h1 {
            text-align: center;
            margin-top: 20px;
        }

        .btn-inicio {
            position: absolute;
            top: 20px;
            left: 20px;
            background: #2ecc71;
            color: white;
            padding: 10px 15px;
            border-radius: 8px;
            text-decoration: none;
        }

        .container {
            width: 80%;
            margin: 30px auto;
        }

        /* BOTONES PRINCIPALES */
        .accordion {
            background: white;
            color: #000; /* 🔥 TEXTO NEGRO */
            font-weight: bold;
            cursor: pointer;
            padding: 15px;
            width: 100%;
            border: none;
            text-align: left;
            font-size: 16px;
            margin-top: 10px;
            border-radius: 10px;
            transition: 0.3s;
        }

            .accordion:hover {
                background: #dff5e1;
                color: #000;
            }

        /* CONTENIDO DESPLEGABLE */
        .panel {
            display: none;
            background: #f9f9f9;
            padding: 15px;
            border-radius: 0 0 10px 10px;
            color: black; /* 🔥 TEXTO NEGRO */
        }

            .panel button {
                margin: 5px;
                padding: 8px 12px;
                background: #2ecc71;
                border: none;
                color: white;
                border-radius: 6px;
                cursor: pointer;
            }

            .panel input {
                width: 100%;
                padding: 8px;
                margin-top: 5px;
            }

    </style>
</head>

<body>

    <a href="/Account/Login" class="btn-inicio">⬅️ Inicio</a>

    <h1>⚡ Panel de Usuario</h1>

    <div class="container">

        <!-- DASHBOARD -->
        <button class="accordion">📊 Dashboard</button>
        <div class="panel">
            <p>Consumo actual: <b>120 kWh</b></p>
            <p>Gasto del mes: <b>$850</b></p>
        </div>

        <!-- REPORTES -->
        <button class="accordion">📈 Reportes</button>
        <div class="panel">
            <p>Consumo por día / semana / mes</p>
        </div>

        <!-- CONTROL -->
        <button class="accordion">💡 Control</button>
        <div class="panel">
            <button>Encender</button>
            <button>Apagar</button>
        </div>

        <!-- HORARIOS -->
        <button class="accordion">⏰ Horarios</button>
        <div class="panel">
            <input type="time" />
            <button>Guardar</button>
        </div>

        <!-- ALERTAS -->
        <button class="accordion">🚨 Alertas</button>
        <div class="panel">
            <p>Alto consumo detectado</p>
        </div>

        <!-- PERFIL -->
        <button class="accordion">👤 Perfil</button>
        <div class="panel">
            <input type="text" placeholder="Nombre" />
            <input type="email" placeholder="Correo" />
            <input type="password" placeholder="Contraseña" />
            <button>Guardar cambios</button>
        </div>

    </div>

    <script>
        var acc = document.getElementsByClassName("accordion");

        for (var i = 0; i < acc.length; i++) {
            acc[i].addEventListener("click", function () {

                var panel = this.nextElementSibling;

                if (panel.style.display === "block") {
                    panel.style.display = "none";
                } else {
                    panel.style.display = "block";
                }
            });
        }
    </script>

</body>
</html>