@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>EnergySaver - Admin</title>

    <style>

        body {
            margin: 0;
            font-family: 'Segoe UI',sans-serif;
            background: linear-gradient(135deg,#0f2027,#2ecc71);
            color: white;
        }

        h1 {
            text-align: center;
            margin-top: 20px;
            font-size: 28px;
        }

        .btn-inicio {
            position: absolute;
            top: 20px;
            left: 20px;
            background: #111;
            color: white;
            padding: 10px 18px;
            border-radius: 12px;
            text-decoration: none;
            font-size: 14px;
            transition: .3s;
            box-shadow: 0 0 10px rgba(46,204,113,.6);
        }

            .btn-inicio:hover {
                background: #2ecc71;
            }

        .container {
            width: 85%;
            max-width: 950px;
            margin: 30px auto;
        }

        .accordion {
            background: rgba(255,255,255,.93);
            color: #222;
            cursor: pointer;
            padding: 18px;
            width: 100%;
            border: none;
            outline: none;
            text-align: left;
            font-size: 18px;
            margin-top: 12px;
            border-radius: 18px;
            transition: .3s;
            font-weight: bold;
            box-shadow: 0 5px 15px rgba(0,0,0,.15);
        }

            .accordion:hover {
                background: #2ecc71;
                color: white;
            }

        .panel {
            display: none;
            background: rgba(255,255,255,.95);
            padding: 15px;
            border-radius: 0 0 18px 18px;
            margin-top: -5px;
            margin-bottom: 10px;
        }

            .panel a {
                display: block;
                margin: 10px 0;
                color: #2ecc71;
                text-decoration: none;
                font-weight: bold;
                font-size: 15px;
                padding: 10px;
                border-radius: 10px;
                transition: .3s;
            }

                .panel a:hover {
                    background: #2ecc71;
                    color: white;
                }

    </style>

</head>

<body>

    <a href="/Account/Login" class="btn-inicio">
        ⬅️ Inicio
    </a>

    <h1>
        ⚡ Panel Administrador
    </h1>

    <div class="container">

        <!-- USUARIOS -->
        <button class="accordion">
            👥 Gestión de Usuarios
        </button>

        <div class="panel">

            <a href="/Admin/Usuarios">
                📋 Ver usuarios
            </a>

            <a href="/Admin/Create">
                ➕ Crear usuario
            </a>

        </div>

        <!-- DISPOSITIVOS -->
        <button class="accordion">
            💡 Gestión de Dispositivos
        </button>

        <div class="panel">

            <a href="/Dispositivos/Create">
                ➕ Agregar dispositivo
            </a>

            <a href="/Dispositivos/Index">
                📋 Ver dispositivos
            </a>

        </div>

        <!-- CONFIGURACION -->
        <button class="accordion">
            ⚙️ Configuración del Sistema
        </button>

        <div class="panel">

            <a asp-controller="Admin"
               asp-action="Tarifa">

                💰 Cambiar tarifa CFE

            </a>

            <a asp-controller="Admin"
               asp-action="Impuestos">

                🧾 Impuestos

            </a>

            <a asp-controller="Admin"
               asp-action="Horarios">

                🕒 Horarios

            </a>

        </div>

        <!-- REGLAS -->
        <button class="accordion">
            📏 Límites y Reglas
        </button>

        <div class="panel">

            <a href="#">
                ⚡ Limitar consumo
            </a>

            <a href="#">
                ❄️ Apagar clima automático
            </a>

        </div>

        <!-- REPORTES -->
        <button class="accordion">
            📊 Reportes Globales
        </button>

        <div class="panel">

            <a href="#">
                📈 Ver consumo total
            </a>

            <a href="#">
                📅 Comparar meses
            </a>

            <a href="#">
                📤 Exportar a Excel
            </a>

        </div>

        <!-- BITACORA -->
        <button class="accordion">
            📜 Logs / Bitácora
        </button>

        <div class="panel">

            <a href="#">
                🔍 Ver actividad
            </a>

            <a href="#">
                🔐 Intentos de login
            </a>

        </div>

        <!-- MANTENIMIENTO -->
        <button class="accordion">
            🛠️ Mantenimiento
        </button>

        <div class="panel">

            <a href="#">
                🔄 Reiniciar sistema
            </a>

            <a href="#">
                📡 Medidores
            </a>

            <a href="#">
                ⬆️ Actualizar sistema
            </a>

        </div>

        <!-- ALERTAS -->
        <button class="accordion">
            🚨 Alertas Admin
        </button>

        <div class="panel">

            <a href="#">
                ⚠️ Ver alertas
            </a>

            <a href="#">
                📡 Fallas técnicas
            </a>

        </div>

    </div>

    <script>

        var acc = document.getElementsByClassName("accordion");

        for (var i = 0; i < acc.length; i++) {

            acc[i].addEventListener("click", function () {

                this.classList.toggle("active");

                var panel = this.nextElementSibling;

                if (panel.style.display === "block") {

                    panel.style.display = "none";

                } else {

                    panel.style.display = "block";

                }

            });

        }

    </script>

</body>
</html>