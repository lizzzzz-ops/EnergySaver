@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>Panel Administrador</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>

        body {
            margin: 0;
            font-family: 'Segoe UI', sans-serif;
            background: linear-gradient(135deg,#0b3d2e,#198754,#20c997);
            min-height: 100vh;
            color: white;
        }

        /* =========================
                   BOTON LOGIN
                ==========================*/

        .btn-login {
            position: absolute;
            top: 20px;
            left: 20px;
            background: rgba(0,0,0,.35);
            color: white;
            text-decoration: none;
            padding: 12px 18px;
            border-radius: 14px;
            font-weight: 600;
            backdrop-filter: blur(10px);
            transition: .3s;
            border: 1px solid rgba(255,255,255,.15);
        }

            .btn-login:hover {
                background: rgba(255,255,255,.25);
                color: white;
                transform: translateY(-2px);
            }

        /* =========================
                   HEADER
                ==========================*/

        .header {
            margin: 20px;
            margin-top: 80px;
            background: rgba(0,0,0,.18);
            padding: 22px 30px;
            border-radius: 20px;
            font-size: 34px;
            font-weight: bold;
            box-shadow: 0 4px 15px rgba(0,0,0,.15);
            color: #ffffff;
        }

        /* =========================
                   MENU
                ==========================*/

        .menu-container {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            padding: 0 20px;
            margin-bottom: 20px;
        }

        .menu-card {
            background: rgba(255,255,255,.15);
            border: none;
            color: #ffffff;
            padding: 14px 22px;
            border-radius: 14px;
            font-size: 15px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 10px;
            transition: .3s;
            cursor: pointer;
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 10px rgba(0,0,0,.12);
        }

            .menu-card:hover {
                background: rgba(255,255,255,.28);
                transform: translateY(-2px);
            }

            .menu-card.active {
                background: rgba(255,255,255,.35);
                border: 1px solid rgba(255,255,255,.25);
            }

            .menu-card i {
                font-size: 18px;
            }

        /* =========================
                   PANELS
                ==========================*/

        .content-panel {
            display: none;
            margin: 0 20px 20px 20px;
            background: rgba(255,255,255,.97);
            border-radius: 22px;
            padding: 20px;
            animation: fade .3s ease;
            box-shadow: 0 8px 20px rgba(0,0,0,.15);
        }

        @@keyframes fade {

            from {
                opacity: 0;
                transform: translateY(-10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .content-panel a {
            display: block;
            background: #f4f4f4;
            padding: 18px;
            border-radius: 16px;
            margin-bottom: 14px;
            text-decoration: none;
            color: #14532d;
            font-weight: 600;
            transition: .3s;
        }

            .content-panel a:hover {
                background: #198754;
                color: white;
                transform: translateX(4px);
            }

        .content-panel i {
            margin-right: 10px;
            font-size: 18px;
        }

        /* =========================
                   ICONOS COLORIDOS
                ==========================*/

        .usuarios-icon {
            color: #7c3aed;
        }

        .dispositivos-icon {
            color: #f59e0b;
        }

        .config-icon {
            color: #0ea5e9;
        }

        .limites-icon {
            color: #ef4444;
        }

        .reportes-icon {
            color: #10b981;
        }

        .logs-icon {
            color: #6366f1;
        }

        .mantenimiento-icon {
            color: #f97316;
        }

        .alertas-icon {
            color: #dc2626;
        }

        /* =========================
                   RESPONSIVE
                ==========================*/

        @@media(max-width:768px) {

            .menu-container {
                flex-direction: column;
            }

            .menu-card {
                width: 100%;
            }

            .header {
                font-size: 26px;
            }
        }

    </style>

</head>

<body>

    <!-- BOTON LOGIN -->

    <a href="/Account/Login"
       class="btn-login">

        ⬅️ Regresar al Login

    </a>

    <!-- HEADER -->

    <div class="header">

        ⚡ Panel Administrador

    </div>

    <!-- MENU PRINCIPAL -->

    <div class="menu-container">

        <button class="menu-card active"
                onclick="showPanel('usuarios', this)">

            <i class="bi bi-people-fill usuarios-icon"></i>

            Usuarios

        </button>

        <button class="menu-card"
                onclick="showPanel('dispositivos', this)">

            <i class="bi bi-cpu-fill dispositivos-icon"></i>

            Dispositivos

        </button>

        <button class="menu-card"
                onclick="showPanel('configuracion', this)">

            <i class="bi bi-gear-fill config-icon"></i>

            Configuración

        </button>

        <button class="menu-card"
                onclick="showPanel('reglas', this)">

            <i class="bi bi-sliders limites-icon"></i>

            Límites

        </button>

        <button class="menu-card"
                onclick="showPanel('reportes', this)">

            <i class="bi bi-bar-chart-fill reportes-icon"></i>

            Reportes

        </button>

        <button class="menu-card"
                onclick="showPanel('logs', this)">

            <i class="bi bi-journal-text logs-icon"></i>

            Logs

        </button>

        <button class="menu-card"
                onclick="showPanel('mantenimiento', this)">

            <i class="bi bi-tools mantenimiento-icon"></i>

            Mantenimiento

        </button>

        <button class="menu-card"
                onclick="showPanel('alertas', this)">

            <i class="bi bi-bell-fill alertas-icon"></i>

            Alertas

        </button>

    </div>

    <!-- USUARIOS -->

    <div id="usuarios"
         class="content-panel"
         style="display:block;">

        <a href="/Admin/Usuarios">
            📋 Ver usuarios
        </a>

        <a href="/Admin/Create">
            ➕ Crear usuario
        </a>

        <a href="#">
            ❌ Eliminar usuario
        </a>

    </div>

    <!-- DISPOSITIVOS -->

    <div id="dispositivos"
         class="content-panel">

        <a href="/Dispositivos/Create">
            ➕ Agregar dispositivo
        </a>

        <a href="/Dispositivos/Index">
            💡 Ver dispositivos
        </a>

        <a href="#">
            ✏️ Editar dispositivo
        </a>

    </div>

    <!-- CONFIG -->

    <div id="configuracion"
         class="content-panel">

        <a href="/Admin/Tarifa">
            💰 Cambiar tarifa
        </a>

        <a href="/Admin/Impuestos">
            🧾 Impuestos
        </a>

        <a href="/Admin/Horarios">
            🕒 Horarios
        </a>

    </div>

    <!-- LIMITES -->

    <div id="reglas"
         class="content-panel">

        <a href="/Admin/LimiteConsumo">
            ⚡ Limitar consumo
        </a>

    </div>

    <!-- REPORTES -->

    <div id="reportes"
         class="content-panel">

        <a href="/Reportes/ConsumoTotal">
            📈 Ver consumo total
        </a>

        <a href="/Reportes/CompararMeses">
            📅 Comparar meses
        </a>

        <a href="/Reportes/ExportarExcel">
           📤 Exportar Excel
        </a>

    </div>

    <!-- LOGS -->

    <div id="logs"
         class="content-panel">

        <a href="/Logs/Actividad">
    
            🔍 Ver actividad
        </a>

        <a href="/Logs/IntentosLogin">
            🔐 Intentos login
        </a>

    </div>

    <!-- MANTENIMIENTO -->

    <div id="mantenimiento"
         class="content-panel">

        <a href="/Mantenimiento/Reiniciar">
            🔄 Reiniciar sistema
        </a>

        <a href="/Mantenimiento/Medidores">
            📡 Medidores
        </a>

        <a href="/Mantenimiento/Actualizar">
            ⬆️ Actualizar sistema
        </a>

    </div>

    <!-- ALERTAS -->

    <div id="alertas"
         class="content-panel">

        <a href="/Alertas/VerAlertas">
            ⚠️ Ver alertas
        </a>

        <a href="/Alertas/FallasTecnicas">
            🚨 Fallas técnicas
        </a>

    </div>

    <script>

        function showPanel(panelId, buttonElement) {

            // ocultar todos los panels

            let panels =
                document.querySelectorAll(".content-panel");

            panels.forEach(panel => {

                panel.style.display = "none";

            });

            // quitar active a todos

            let buttons =
                document.querySelectorAll(".menu-card");

            buttons.forEach(btn => {

                btn.classList.remove("active");

            });

            // mostrar panel seleccionado

            document.getElementById(panelId)
                .style.display = "block";

            // activar boton

            buttonElement.classList.add("active");
        }

    </script>

</body>

</html>