@model EnergySaver.Models.Configuracion

@{
    ViewData["Title"] = "Editar Horario";
}

<style>

    body {
        background: linear-gradient(135deg,#031d1f,#0d5c3f,#2ecc71);
        font-family: 'Segoe UI';
    }

    .contenedor {
        width: 80%;
        max-width: 600px;
        margin: 40px auto;
        background: white;
        border-radius: 25px;
        padding: 30px;
    }

    h1 {
        text-align: center;
        color: #2ecc71;
        margin-bottom: 30px;
    }

    label {
        font-weight: bold;
        display: block;
        margin-bottom: 10px;
    }

    input {
        width: 100%;
        padding: 14px;
        border-radius: 14px;
        border: 2px solid #ddd;
        margin-bottom: 20px;
    }

    .btn {
        width: 100%;
        padding: 14px;
        border: none;
        border-radius: 14px;
        background: #2ecc71;
        color: white;
        font-weight: bold;
    }

</style>

<div class="contenedor">

    <h1>
        ✏️ Editar Horario
    </h1>

    <form method="post">

        <input type="hidden" asp-for="Id">

        <label>Hora Inicio</label>

        <input type="time" asp-for="HoraInicio">

        <label>Hora Fin</label>

        <input type="time" asp-for="HoraFin">

        <button type="submit" class="btn">
            Guardar Cambios
        </button>

    </form>

</div>