@model Usuario

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>Agregar Usuario</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>

        body {
            margin: 0;
            font-family: 'Segoe UI', sans-serif;
            background: linear-gradient(135deg,#0b3d2e,#198754,#20c997);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .card-form {
            width: 430px;
            background: rgba(255,255,255,.97);
            padding: 40px;
            border-radius: 24px;
            box-shadow: 0 10px 30px rgba(0,0,0,.2);
            animation: fade .4s ease;
        }

        @@keyframes fade {

            from {
                opacity: 0;
                transform: translateY(-10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        h2 {
            text-align: center;
            color: #0f5132;
            margin-bottom: 30px;
            font-weight: bold;
        }

        .form-control {
            border-radius: 12px;
            padding: 12px;
            margin-bottom: 15px;
            border: 1px solid #dcdcdc;
        }

            .form-control:focus {
                border-color: #198754;
                box-shadow: 0 0 0 .15rem rgba(25,135,84,.2);
            }

        .btn-save {
            width: 100%;
            background: #198754;
            color: white;
            border: none;
            padding: 14px;
            border-radius: 12px;
            font-weight: bold;
            transition: .3s;
        }

            .btn-save:hover {
                background: #146c43;
                transform: translateY(-2px);
            }

        .btn-back {
            position: absolute;
            top: 20px;
            left: 20px;
            text-decoration: none;
            background: rgba(0,0,0,.25);
            color: white;
            padding: 12px 18px;
            border-radius: 14px;
            font-weight: 600;
            transition: .3s;
            backdrop-filter: blur(10px);
        }

            .btn-back:hover {
                background: rgba(255,255,255,.2);
                color: white;
            }

    </style>

</head>

<body>

    <!-- BOTON VOLVER -->

    <a href="/Admin/Dashboard"
       class="btn-back">

        ⬅️ Regresar

    </a>

    <!-- FORM -->

    <div class="card-form">

        <h2>
            ➕ Agregar Usuario
        </h2>

        <form method="post">

            <input asp-for="Nombre"
                   class="form-control"
                   placeholder="Nombre" />

            <input asp-for="Correo"
                   class="form-control"
                   placeholder="Correo" />

            <input asp-for="Password"
                   class="form-control"
                   placeholder="Contraseña" />

            <input asp-for="Rol"
                   class="form-control"
                   placeholder="Rol (Admin/Usuario)" />

            <button type="submit"
                    class="btn-save">

                Guardar Usuario

            </button>

        </form>

    </div>

</body>

</html>