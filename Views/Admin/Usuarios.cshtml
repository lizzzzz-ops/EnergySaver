@model IEnumerable<EnergySaver.Models.Usuario>

<style>

    body {
        background: linear-gradient(135deg, #031f1b, #2ecc71);
        min-height: 100vh;
        font-family: 'Segoe UI', sans-serif;
        overflow-x: hidden;
    }

    /* QUITAR BARRAS */
    header,
    nav,
    .navbar,
    footer {
        display: none !important;
    }

    .contenedor-usuarios {
        background: rgba(255,255,255,0.88);
        backdrop-filter: blur(12px);
        border-radius: 30px;
        padding: 28px;
        margin-top: 35px;
        box-shadow: 0 8px 30px rgba(0,0,0,0.25);
    }

    .titulo {
        text-align: center;
        font-size: 30px;
        font-weight: bold;
        color: #2ecc71;
        margin-bottom: 25px;
    }

    .btn-panel {
        background: #111;
        color: white;
        padding: 10px 20px;
        border-radius: 16px;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        border: 2px solid #2ecc71;
        box-shadow: 0 0 15px rgba(46,204,113,0.5);
        transition: 0.3s;
    }

        .btn-panel:hover {
            background: #2ecc71;
            color: black;
            transform: scale(1.05);
        }

    /* ALERTAS */

    .alerta-success {
        width: 420px;
        margin: 0 auto 20px auto;
        padding: 14px;
        background: linear-gradient(135deg,#2ecc71,#27ae60);
        color: white;
        text-align: center;
        border-radius: 15px;
        font-size: 15px;
        font-weight: 600;
        box-shadow: 0 0 20px rgba(46,204,113,0.5);
        animation: aparecerAlerta 0.5s ease;
    }

    .alerta-error {
        width: 420px;
        margin: 0 auto 20px auto;
        padding: 14px;
        background: linear-gradient(135deg,#ff4d4d,#c0392b);
        color: white;
        text-align: center;
        border-radius: 15px;
        font-size: 15px;
        font-weight: 600;
        box-shadow: 0 0 20px rgba(255,0,0,0.4);
        animation: aparecerAlerta 0.5s ease;
    }

    @@keyframes aparecerAlerta {

        from {
            opacity: 0;
            transform: translateY(-15px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    table {
        width: 100%;
        border-collapse: collapse;
        overflow: hidden;
        border-radius: 20px;
    }

    thead {
        background: #2ecc71;
        color: white;
    }

        thead th {
            padding: 14px;
            font-size: 15px;
        }

    tbody tr {
        background: rgba(255,255,255,0.6);
        transition: 0.3s;
    }

        tbody tr:hover {
            background: rgba(255,255,255,0.9);
        }

    tbody td {
        padding: 14px;
        font-size: 14px;
        vertical-align: middle;
    }

    .acciones-container {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        align-items: center;
    }

    .btn-accion {
        border: none;
        padding: 8px 12px;
        border-radius: 12px;
        font-size: 13px;
        font-weight: 600;
        color: white;
        transition: 0.3s;
        display: flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
    }

    .btn-editar {
        background: #3498db;
        text-decoration: none;
    }

    .btn-eliminar {
        background: #e74c3c;
    }

    .btn-reset {
        background: #2ecc71;
    }

    .btn-accion:hover {
        transform: scale(1.05);
        opacity: 0.9;
    }

    .iconito {
        width: 22px;
        height: 22px;
        object-fit: cover;
        border-radius: 6px;
    }

    /* MODALES */

    .modal-custom {
        display: none;
        position: fixed;
        z-index: 9999;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.82);
        overflow-y: auto;
    }

    .modal-image-content {
        width: 420px;
        margin: 40px auto;
        text-align: center;
        animation: aparecer 0.3s ease;
    }

    .alert-image {
        width: 100%;
        border-radius: 25px;
        display: block;
        box-shadow: 0 0 25px rgba(0,0,0,0.5);
    }

    .custom-buttons {
        margin-top: 18px;
        display: flex;
        justify-content: center;
        gap: 14px;
    }

    .btn-confirmar {
        background: #2ecc71;
        color: black;
        border: none;
        padding: 10px 22px;
        border-radius: 12px;
        font-size: 14px;
        font-weight: bold;
        cursor: pointer;
        transition: 0.3s;
    }

    .btn-cancelar {
        background: #e74c3c;
        color: white;
        border: none;
        padding: 10px 22px;
        border-radius: 12px;
        font-size: 14px;
        font-weight: bold;
        cursor: pointer;
        transition: 0.3s;
    }

        .btn-confirmar:hover,
        .btn-cancelar:hover {
            transform: scale(1.05);
        }

    @@keyframes aparecer {

        from {
            opacity: 0;
            transform: scale(0.8);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

</style>

<div class="container">

    <div class="contenedor-usuarios">

        <a href="/Admin/Dashboard" class="btn-panel">
            ← Panel
        </a>

        <h1 class="titulo">
            👥 Gestión de Usuarios
        </h1>

        @if (TempData["Success"] != null)
        {
            <div class="alerta-success">
                ✅ @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alerta-error">
                ❌ @TempData["Error"]
            </div>
        }

        <table>

            <thead>

                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Correo</th>
                    <th>Rol</th>
                    <th>Acciones</th>
                </tr>

            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>@item.IdUsuario</td>
                        <td>@item.Nombre</td>
                        <td>@item.Correo</td>
                        <td>@item.Rol</td>

                        <td>

                            <div class="acciones-container">

                                <a asp-action="Edit"
                                   asp-route-id="@item.IdUsuario"
                                   class="btn-accion btn-editar">

                                    Editar

                                </a>

                                <button class="btn-accion btn-eliminar"
                                        onclick="abrirEliminar('@item.IdUsuario')">

                                    <img src="/imagenes/delete.png"
                                         class="iconito" />

                                    Eliminar

                                </button>

                                <button class="btn-accion btn-reset"
                                        onclick="abrirReset('@item.IdUsuario')">

                                    <img src="/imagenes/reset.png"
                                         class="iconito" />

                                    Restablecer contraseña

                                </button>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

<!-- MODAL ELIMINAR -->

<div id="modalEliminar" class="modal-custom">

    <div class="modal-image-content">

        <img src="/imagenes/delete-alert.png"
             class="alert-image" />

        <div class="custom-buttons">

            <form id="formEliminar"
                  method="post"
                  action="/Admin/Eliminar">

                <input type="hidden"
                       id="idEliminar"
                       name="id" />

                <button type="submit"
                        class="btn-confirmar">

                    Aceptar

                </button>

            </form>

            <button class="btn-cancelar"
                    onclick="cerrarModal('modalEliminar')">

                Cancelar

            </button>

        </div>

    </div>

</div>

<!-- MODAL RESET -->

<div id="modalReset" class="modal-custom">

    <div class="modal-image-content">

        <img src="/imagenes/reset-alert.png"
             class="alert-image" />

        <div class="custom-buttons">

            <a id="btnResetConfirmar"
               class="btn-confirmar">

                Aceptar

            </a>

            <button class="btn-cancelar"
                    onclick="cerrarModal('modalReset')">

                Cancelar

            </button>

        </div>

    </div>

</div>

<script>

    function abrirEliminar(id) {

        document.getElementById("modalEliminar").style.display = "block";

        document.getElementById("idEliminar").value = id;
    }

    function abrirReset(id) {

        document.getElementById("modalReset").style.display = "block";

        document.getElementById("btnResetConfirmar")
            .href = "/Admin/ResetPassword/" + id;
    }

    function cerrarModal(id) {

        document.getElementById(id).style.display = "none";
    }

    window.onclick = function (event) {

        let modalEliminar = document.getElementById("modalEliminar");
        let modalReset = document.getElementById("modalReset");

        if (event.target == modalEliminar) {

            modalEliminar.style.display = "none";
        }

        if (event.target == modalReset) {

            modalReset.style.display = "none";
        }
    }

</script>