@model IEnumerable<EnergySaver.Models.Configuracion>

@{
    ViewData["Title"] = "Limitar Consumo";
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

<style>

    body {
        background: linear-gradient(135deg,#031d1f,#0d5c3f,#2ecc71);
        font-family: 'Segoe UI';
    }

    .contenedor {
        width: 80%;
        max-width: 900px;
        margin: 40px auto;
        background: white;
        border-radius: 25px;
        padding: 35px;
        box-shadow: 0 10px 25px rgba(0,0,0,.25);
    }

    h1 {
        text-align: center;
        color: #2ecc71;
        margin-bottom: 35px;
        font-size: 30px;
        font-weight: bold;
    }

    label {
        font-size: 17px;
        font-weight: bold;
        color: #222;
        display: block;
        margin-bottom: 10px;
    }

    input {
        width: 100%;
        padding: 15px;
        border-radius: 15px;
        border: 2px solid #ddd;
        font-size: 16px;
        margin-bottom: 25px;
        outline: none;
        transition: .3s;
    }

        input:focus {
            border-color: #2ecc71;
            box-shadow: 0 0 10px rgba(46,204,113,.5);
        }

    .acciones-form {
        display: flex;
        justify-content: center;
        gap: 15px;
        margin-bottom: 25px;
    }

    .btn {
        border: none;
        padding: 12px 22px;
        border-radius: 14px;
        color: white;
        font-size: 14px;
        font-weight: bold;
        cursor: pointer;
        transition: .3s;
        text-decoration: none;
    }

        .btn:hover {
            transform: scale(1.05);
        }

    .guardar {
        background: #2ecc71;
    }

    .editar {
        background: #3498db;
    }

    .eliminar {
        background: #e74c3c;
    }

    .consultar {
        background: #9b59b6;
    }

        .consultar:hover {
            background: #8e44ad;
        }

    .btn-regresar {
        display: inline-block;
        margin-bottom: 20px;
        background: #111;
        color: white;
        padding: 10px 20px;
        border-radius: 14px;
        text-decoration: none;
        font-weight: bold;
        transition: .3s;
    }

        .btn-regresar:hover {
            background: #2ecc71;
        }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 25px;
    }

    th {
        background: #2ecc71;
        color: white;
        padding: 16px;
        font-size: 15px;
    }

    td {
        padding: 16px;
        text-align: center;
        border-bottom: 1px solid #ddd;
        font-size: 15px;
        color: black;
    }

    .acciones-tabla {
        display: flex;
        justify-content: center;
        gap: 10px;
    }

</style>

<div class="contenedor">

    <!-- BOTÓN REGRESAR -->
    <a asp-action="Dashboard"
       class="btn-regresar">

        ⬅ Inicio

    </a>

    <!-- TÍTULO -->
    <h1>
        ⚡ Limitar Consumo
    </h1>

    <!-- FORMULARIO -->
    <form method="post"
          asp-action="GuardarLimite">

        <label>
            Límite máximo de consumo (kWh)
        </label>

        <input type="number"
               name="limite"
               placeholder="Ejemplo: 500"
               required />

        <!-- BOTONES -->
        <div class="acciones-form">

            <!-- GUARDAR -->
            <button type="submit"
                    class="btn guardar">

                💾 Guardar

            </button>

            <!-- CONSULTAR -->
            <button type="button"
                    onclick="mostrarTabla()"
                    class="btn consultar">

                📋 Consultar Datos

            </button>

        </div>

    </form>

    <!-- TABLA OCULTA -->
    <div id="contenidoTabla"
         style="display:none;">

        <table>

            <tr>

                <th>ID</th>
                <th>Límite</th>
                <th>Acciones</th>

            </tr>

            @foreach (var item in Model)
            {
                <tr>

                    <td>@item.Id</td>

                    <td>
                        @item.LimiteConsumo kWh
                    </td>

                    <td>

                        <div class="acciones-tabla">

                            <!-- EDITAR -->
                            <a href="#"
                               class="btn editar"
                               onclick="editarLimite('@item.Id','@item.LimiteConsumo')">

                                ✏️ Editar

                            </a>

                            <!-- ELIMINAR -->
                            <a href="#"
                               class="btn eliminar"
                               onclick="confirmarEliminar(@item.Id)">

                                🗑 Eliminar

                            </a>

                        </div>

                    </td>

                </tr>
            }

        </table>

    </div>

</div>

<script>

    // MOSTRAR TABLA
    function mostrarTabla(){

        let contenido =
        document.getElementById("contenidoTabla").innerHTML;

        Swal.fire({

            title: '📋 Límites Registrados',

            html: contenido,

            width: '900px',

            background: '#ffffff',

            color: '#222',

            confirmButtonText: 'Cerrar',

            confirmButtonColor: '#2ecc71',

            allowOutsideClick: true,

            allowEscapeKey: true,

            scrollbarPadding: false,

            showClass: {
                popup: 'animate__animated animate__zoomIn'
            },

            hideClass: {
                popup: 'animate__animated animate__zoomOut'
            }

        });

    }

    // EDITAR
    function editarLimite(id, limite){

        Swal.fire({

            title:'Editar límite',

            input:'number',

            inputValue: limite,

            background:'#031d1f',

            color:'white',

            confirmButtonColor:'#3498db',

            confirmButtonText:'Guardar',

            cancelButtonText:'Cancelar',

            showCancelButton:true,

            showClass:{
                popup:'animate__animated animate__zoomIn'
            },

            hideClass:{
                popup:'animate__animated animate__zoomOut'
            }

        }).then((result)=>{

            if(result.isConfirmed){

                window.location.href =
                '/Admin/EditarLimite?id='
                + id +
                '&limite=' +
                result.value;

            }

        });

    }

    // ELIMINAR
    function confirmarEliminar(id){

        Swal.fire({

            title:'¿Eliminar límite?',

            text:'Esta acción no se puede deshacer',

            icon:'warning',

            background:'#031d1f',

            color:'white',

            confirmButtonColor:'#2ecc71',

            cancelButtonColor:'#e74c3c',

            confirmButtonText:'Sí, eliminar',

            cancelButtonText:'Cancelar',

            showCancelButton:true,

            showClass:{
                popup:'animate__animated animate__zoomIn'
            },

            hideClass:{
                popup:'animate__animated animate__zoomOut'
            }

        }).then((result)=>{

            if(result.isConfirmed){

                window.location.href =
                '/Admin/EliminarLimite/' + id;

            }

        });

    }

</script>