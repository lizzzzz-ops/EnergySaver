@model IEnumerable<EnergySaver.Models.Configuracion>

@{
    ViewData["Title"] = "Consultar Horarios";
}

<style>

    body {
        background: linear-gradient(135deg,#031d1f,#0d5c3f,#2ecc71);
        font-family: 'Segoe UI';
    }

    .contenedor {
        width: 80%;
        max-width: 900px;
        margin: 40px auto;
        background: white;
        border-radius: 25px;
        padding: 30px;
        box-shadow: 0 10px 25px rgba(0,0,0,.25);
    }

    h1 {
        text-align: center;
        color: #2ecc71;
        margin-bottom: 30px;
        font-size: 28px;
        font-weight: bold;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th {
        background: #2ecc71;
        color: white;
        padding: 16px;
        font-size: 15px;
    }

    td {
        padding: 16px;
        text-align: center;
        border-bottom: 1px solid #ddd;
        font-size: 15px;
    }

    .btn-regresar {
        display: inline-block;
        margin-bottom: 20px;
        background: #111;
        color: white;
        padding: 10px 20px;
        border-radius: 14px;
        text-decoration: none;
        font-weight: bold;
        transition: .3s;
    }

        .btn-regresar:hover {
            background: #2ecc71;
        }

    .acciones {
        display: flex;
        justify-content: center;
        gap: 10px;
    }

    .btn {
        border: none;
        padding: 10px 16px;
        border-radius: 12px;
        color: white;
        text-decoration: none;
        font-size: 13px;
        font-weight: bold;
        transition: .3s;
        cursor: pointer;
    }

        .btn:hover {
            transform: scale(1.05);
        }

    .editar {
        background: #3498db;
    }

    .eliminar {
        background: #e74c3c;
    }

</style>

<div class="contenedor">

    <a asp-action="Horarios" class="btn-regresar">
        ⬅ Regresar
    </a>

    <h1>
        📋 Horarios Registrados
    </h1>

    <table>

        <tr>
            <th>ID</th>
            <th>Hora Inicio</th>
            <th>Hora Fin</th>
            <th>Acciones</th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>

                <td>@item.Id</td>

                <td>@item.HoraInicio</td>

                <td>@item.HoraFin</td>

                <td>

                    <div class="acciones">

                        <a asp-action="EditarHorario"
                           asp-route-id="@item.Id"
                           class="btn editar">

                            ✏️ Editar

                        </a>

                        <a href="#"
                           class="btn eliminar"
                           onclick="confirmarEliminarHorario(@item.Id)">

                            🗑 Eliminar

                        </a>

                    </div>

                </td>

            </tr>
        }

    </table>

</div>

<script>

    function confirmarEliminarHorario(id){

        Swal.fire({

            imageUrl: '/imagenes/eliminar-horario.png',

            imageWidth: 450,
            imageHeight: 450,

            background: 'transparent',

            showCancelButton: true,

            confirmButtonColor: '#2ecc71',
            cancelButtonColor: '#e74c3c',

            confirmButtonText: 'Aceptar',
            cancelButtonText: 'Cancelar',

            width: '700px',

            padding: '20px',
            customClass: {
            popup: 'popup-transparente'
            },

            showClass: {
                popup: 'animate__animated animate__zoomIn'
            },

            hideClass: {
                popup: 'animate__animated animate__zoomOut'
            }

        }).then((result) => {

            if(result.isConfirmed){

                window.location.href =
                '/Admin/EliminarHorario/' + id;
            }

        });

    }

</script>
<style>

  

    .popup-transparente {
        background: transparent !important;
        box-shadow: none !important;
        overflow: hidden !important;
    }

    .swal2-image {
        border-radius: 30px !important;
    }



</style>