    <title>Admin EnergySaver</title>

    <link rel="stylesheet" href="~/css/admin.css" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">
</head>

<body class="admin-body">

    <div class="sidebar">
