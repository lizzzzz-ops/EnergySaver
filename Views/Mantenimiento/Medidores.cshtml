@{
    Layout = null;
}

<!DOCTYPE html>
<html>

<head>

    <title>Actualizar Sistema</title>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>

        body {
            margin: 0;
            font-family: 'Segoe UI';
            background: linear-gradient(135deg,#0b3d2e,#198754,#20c997);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .card {
            background: white;
            padding: 40px;
            border-radius: 20px;
            text-align: center;
            width: 500px;
            box-shadow: 0 10px 30px rgba(0,0,0,.2);
        }

        h1 {
            color: #14532d;
        }

        p{
            color:#555;
            margin-bottom:25px;
        }

        button {
            background: #198754;
            color: white;
            border: none;
            padding: 15px 25px;
            border-radius: 12px;
            cursor: pointer;
            font-size: 18px;
            transition:.3s;
        }

        button:hover{
            background:#146c43;
            transform:scale(1.05);
        }

        a {
            position: absolute;
            top: 20px;
            left: 20px;
            color: white;
            text-decoration: none;
            background: rgba(0,0,0,.2);
            padding: 12px 18px;
            border-radius: 12px;
        }

    </style>

</head>

<body>

    <a href="/Admin/Dashboard">
        ⬅ Volver
    </a>

    <div class="card">

        <h1>
            ⬆ Actualizar Sistema
        </h1>

        <p>
            Buscar nuevas actualizaciones del sistema.
        </p>

        <button onclick="actualizar()">
            Actualizar
        </button>

    </div>

    <script>

        function actualizar(){

            Swal.fire({

                title: 'Actualización completada 🚀',

                html: '<b>EnergySaver</b> se actualizó correctamente.',

                icon: 'success',

                showConfirmButton: true,

                confirmButtonText: 'Aceptar',

                confirmButtonColor: '#198754',

                timer: 3000,

                timerProgressBar: true,

                background: '#ffffff',

                color: '#14532d'

            });

        }

    </script>

</body>

</html>