@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>

    <title>EnergySaver - Usuario</title>

    <style>

        body {
            margin: 0;
            font-family: 'Segoe UI',sans-serif;
            background: linear-gradient(135deg,#0f2027,#2ecc71);
            color: white;
        }

        h1 {
            text-align: center;
            margin-top: 20px;
            font-size: 28px;
        }

        .btn-inicio {
            position: absolute;
            top: 20px;
            left: 20px;
            background: #111;
            color: white;
            padding: 10px 18px;
            border-radius: 12px;
            text-decoration: none;
            font-size: 14px;
            transition: .3s;
            box-shadow: 0 0 10px rgba(46,204,113,.6);
        }

            .btn-inicio:hover {
                background: #2ecc71;
            }

        .container {
            width: 85%;
            max-width: 950px;
            margin: 30px auto;
        }

        /* BARRAS */
        .accordion {
            background: rgba(255,255,255,.93);
            color: #222;
            cursor: pointer;
            padding: 18px;
            width: 100%;
            border: none;
            outline: none;
            text-align: left;
            font-size: 18px;
            margin-top: 12px;
            border-radius: 18px;
            transition: 0.3s;
            font-weight: bold;
            box-shadow: 0 5px 15px rgba(0,0,0,.15);
        }

            /* EFECTO VERDE */
            .accordion:hover,
            .active {
                background: #2ecc71 !important;
                color: white !important;
            }

        /* PANEL */
        .panel {
            display: none;
            background: rgba(255,255,255,.95);
            padding: 15px;
            border-radius: 0 0 18px 18px;
            margin-top: -5px;
            margin-bottom: 10px;
            color: black;
        }

            .panel button {
                margin: 5px;
                padding: 10px 15px;
                background: #2ecc71;
                border: none;
                color: white;
                border-radius: 8px;
                cursor: pointer;
            }

            .panel input {
                width: 100%;
                padding: 10px;
                margin-top: 8px;
                border-radius: 8px;
                border: 1px solid #ccc;
            }

    </style>
</head>

<body>

    <a href="/Account/Login" class="btn-inicio">
        ⬅️ Inicio
    </a>

    <h1>
        ⚡ Panel de Usuario
    </h1>

    <div class="container">

        <!-- DASHBOARD -->
        <button class="accordion">
            📊 Dashboard
        </button>

        <div class="panel">

            <p>
                Consumo actual:
                <b>120 kWh</b>
            </p>

            <p>
                Gasto del mes:
                <b>$850</b>
            </p>

        </div>

        <!-- REPORTES -->
        <button class="accordion">
            📈 Reportes
        </button>

        <div class="panel">

            <p>
                Consumo por día / semana / mes
            </p>

        </div>

        <!-- CONTROL -->
        <button class="accordion">
            💡 Control
        </button>

        <div class="panel">

            <button>Encender</button>

            <button>Apagar</button>

        </div>

        <!-- HORARIOS -->
        <button class="accordion">
            ⏰ Horarios
        </button>

        <div class="panel">

            <input type="time" />

            <button>
                Guardar
            </button>

        </div>

        <!-- ALERTAS -->
        <button class="accordion">
            🚨 Alertas
        </button>

        <div class="panel">

            <p>
                Alto consumo detectado
            </p>

        </div>

        <!-- PERFIL -->
        <button class="accordion">
            👤 Perfil
        </button>

        <div class="panel">

            <input type="text" placeholder="Nombre" />

            <input type="email" placeholder="Correo" />

            <input type="password" placeholder="Contraseña" />

            <button>
                Guardar cambios
            </button>

        </div>

    </div>

    <script>

        var acc = document.getElementsByClassName("accordion");

        for (var i = 0; i < acc.length; i++) {

            acc[i].addEventListener("click", function () {

                this.classList.toggle("active");

                var panel = this.nextElementSibling;

                if (panel.style.display === "block") {

                    panel.style.display = "none";

                } else {

                    panel.style.display = "block";

                }

            });

        }

    </script>


</body>
</html>