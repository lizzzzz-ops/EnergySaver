@model EnergySaver.Models.Dispositivo
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Editar Dispositivo - EnergySaver</title>
    <style>
        body {
            margin: 0;
            background: linear-gradient(135deg, #1a4a31 0%, #28b463 100%);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', sans-serif;
        }

        .form-card {
            background-color: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0px 10px 30px rgba(0,0,0,0.3);
            width: 400px;
            text-align: center;
        }

            .form-card h2 {
                color: #2ecc71;
                margin-bottom: 25px;
            }

        .form-control {
            width: 100%;
            padding: 12px;
            margin-bottom: 15px;
            border: 1px solid #ddd;
            border-radius: 8px;
            box-sizing: border-box;
        }

        .btn-submit {
            background-color: #2ecc71;
            color: white;
            border: none;
            padding: 15px;
            border-radius: 8px;
            width: 100%;
            font-weight: bold;
            cursor: pointer;
            font-size: 16px;
        }

            .btn-submit:hover {
                background-color: #27ae60;
            }
    </style>
</head>
<body>

    <div class="form-card">
        <h2>📝 Editar Dispositivo</h2>

        <form method="post">
            <input type="hidden" name="id_dispositivo" value="@Model.id_dispositivo" />

            <label style="display:block; text-align:left; font-size:12px; color:#666;">Nombre:</label>
            <input name="nombre" value="@Model.nombre" class="form-control" required />

            <label style="display:block; text-align:left; font-size:12px; color:#666;">Ubicación:</label>
            <input name="ubicacion" value="@Model.ubicacion" class="form-control" />

            <label style="display:block; text-align:left; font-size:12px; color:#666;">Tipo:</label>
            <input name="tipo" value="@Model.tipo" class="form-control" />

            <label style="display:block; text-align:left; font-size:12px; color:#666;">Marca:</label>
            <input name="marca" value="@Model.marca" class="form-control" />

            <label style="display:block; text-align:left; font-size:12px; color:#666;">Consumo (W):</label>
            <input name="consumoWatts" type="number" step="0.01" value="@Model.consumoWatts" class="form-control" />

            <button type="submit" class="btn-submit">Guardar Cambios</button>
            <br><br>
            <a href="/Dispositivos/Index" style="text-decoration:none; color:#999; font-size:14px;">Cancelar</a>
        </form>
    </div>

</body>
</html>