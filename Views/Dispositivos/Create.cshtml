@model EnergySaver.Models.Dispositivo
@{
    Layout = null; // Esto es lo que quita el fondo blanco/gris de Visual Studio
}

<!DOCTYPE html>
<html>
<head>
    <title>Agregar Dispositivo - EnergySaver</title>
    <style>
        /* EL DISEÑO VERDE */
        body {
            margin: 0;
            background: linear-gradient(135deg, #1a4a31 0%, #28b463 100%);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', sans-serif;
        }

        /* LA TARJETA BLANCA */
        .form-card {
            background-color: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0px 10px 30px rgba(0,0,0,0.3);
            width: 400px;
            text-align: center;
        }

            .form-card h2 {
                color: #2ecc71;
                margin-bottom: 25px;
            }

        /* LOS CUADROS DE TEXTO */
        .form-control {
            width: 100%;
            padding: 12px;
            margin-bottom: 15px;
            border: 1px solid #ddd;
            border-radius: 8px;
            box-sizing: border-box; /* Evita que se salgan de la tarjeta */
        }

        /* EL BOTÓN */
        .btn-submit {
            background-color: #2ecc71;
            color: white;
            border: none;
            padding: 15px;
            border-radius: 8px;
            width: 100%;
            font-weight: bold;
            cursor: pointer;
            font-size: 16px;
        }

            .btn-submit:hover {
                background-color: #27ae60;
            }

        /* BOTÓN DE REGRESAR */
        .btn-back {
            position: absolute;
            top: 20px;
            left: 20px;
            background: rgba(255,255,255,0.2);
            color: white;
            padding: 10px 15px;
            border-radius: 8px;
            text-decoration: none;
            border: 1px solid white;
        }
    </style>
</head>
<body>

    <a href="/Admin/Dashboard" class="btn-back">⬅ Panel</a>

    <div class="form-card">
        <h2>+ Agregar Dispositivo</h2>

        <form method="post">
            <input name="nombre" class="form-control" placeholder="Nombre del Dispositivo" required />
            <input name="ubicacion" class="form-control" placeholder="Ubicación (Ej. Sala)" />
            <input name="tipo" class="form-control" placeholder="Tipo (Ej. Iluminación)" />
            <input name="marca" class="form-control" placeholder="Marca (Ej. Sony)" />
            <input name="consumoWatts" type="number" step="0.01" class="form-control" placeholder="Consumo (Watts)" />

            <button type="submit" class="btn-submit">Guardar Dispositivo</button>
        </form>
    </div>

</body>
</html>