@model EnergySaver.Models.Dispositivo
@{
    Layout = null; // Quita el fondo blanco/gris de la plantilla por defecto
}

<!DOCTYPE html>
<html>
<head>
    <title>Agregar Dispositivo - EnergySaver</title>
    <style>
        /* 1. EL FONDO: Verde pino oscuro y sólido del Panel de Usuario */
        body {
            margin: 0;
            background-color: #1a4d38;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', sans-serif;
        }

        /* 2. LA TARJETA: Mismo tono verde muy oscuro que la barra superior del panel */
        .form-card {
            background-color: #0f3625;
            border: 1px solid rgba(255, 255, 255, 0.08);
            padding: 35px;
            border-radius: 12px;
            box-shadow: 0px 12px 35px rgba(0,0,0,0.5);
            width: 400px;
            text-align: center;
        }

            /* 3. TÍTULO: Verde claro suave idéntico a los textos destacados del panel */
            .form-card h2 {
                color: #5cd699;
                margin-top: 0;
                margin-bottom: 25px;
                font-size: 24px;
                font-weight: 600;
            }

        /* 4. LOS CAMPOS DE TEXTO: Integrados al fondo oscuro sin contrastes bruscos */
        .form-control {
            width: 100%;
            padding: 12px;
            margin-bottom: 15px;
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 6px;
            box-sizing: border-box; /* Evita que se salgan de la tarjeta */
            color: #ffffff;
            font-size: 15px;
            transition: all 0.2s ease;
        }

            .form-control:focus {
                outline: none;
                border-color: #2bb673;
                background: rgba(255, 255, 255, 0.1);
                box-shadow: 0 0 8px rgba(43, 182, 115, 0.25);
            }

            /* Color del texto de ayuda (placeholder) */
            .form-control::placeholder {
                color: rgba(255, 255, 255, 0.4);
            }

        /* 5. EL BOTÓN PRINCIPAL: Con el verde de tu botón original "+ Agregar" */
        .btn-submit {
            background-color: #135237;
            color: white;
            border: 1px solid rgba(255, 255, 255, 0.15);
            padding: 14px;
            border-radius: 6px;
            width: 100%;
            font-weight: bold;
            cursor: pointer;
            font-size: 15px;
            transition: background-color 0.2s ease;
        }

            .btn-submit:hover {
                background-color: #1a6948;
            }

        /* 6. BOTÓN DE REGRESAR: Estilo de las pestañas superiores del panel */
        .btn-back {
            position: absolute;
            top: 20px;
            left: 20px;
            background: rgba(255, 255, 255, 0.07);
            color: #a3c2b2;
            padding: 9px 16px;
            border-radius: 6px;
            text-decoration: none;
            border: 1px solid rgba(255, 255, 255, 0.1);
            font-size: 14px;
            transition: all 0.2s ease;
        }

            .btn-back:hover {
                background: rgba(255, 255, 255, 0.15);
                color: #ffffff;
            }
    </style>
</head>
<body>

    <a href="/Home/Usuario" class="btn-back">⬅ Volver al Panel</a>

    <div class="form-card">
        <h2>+ Agregar Dispositivo</h2>

        <form method="post">
            <input name="nombre" class="form-control" placeholder="Nombre del Dispositivo" required />
            <input name="ubicacion" class="form-control" placeholder="Ubicación (Ej. Sala)" />
            <input name="tipo" class="form-control" placeholder="Tipo (Ej. Iluminación)" />
            <input name="marca" class="form-control" placeholder="Marca (Ej. Sony)" />
            <input name="consumoWatts" type="number" step="0.01" class="form-control" placeholder="Consumo (Watts)" />

            <button type="submit" class="btn-submit">Guardar Dispositivo</button>
        </form>
    </div>

</body>
</html>